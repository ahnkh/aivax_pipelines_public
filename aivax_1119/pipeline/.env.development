# Pipeline runtime / HTTP server
AIVAX_PIPELINE_RUNTIME_DIR=./.runtime/development
AIVAX_PIPELINE_HOST=0.0.0.0
AIVAX_PIPELINE_PORT=29099
AIVAX_PIPELINE_WORKERS=1
AIVAX_PIPELINE_CORS_ORIGINS=*
AIVAX_PIPELINE_SSL_KEY_FILE=
AIVAX_PIPELINE_SSL_CERT_FILE=
# Global filter enablement is configured in mode.json.
AIVAX_PIPELINE_MODE_FILE=../../config/aivax/mode.json

# Application process logs (stdout + trace files)
AIVAX_PIPELINE_LOG_LEVEL=debug
AIVAX_PIPELINE_TRACE_LOG_PATH=./.runtime/development/trace-log

# Policy refresh
AIVAX_PIPELINE_POLICY_POLL_INTERVAL_SECONDS=10

# Analysis logs (OpenSearch-compatible bulk files)
AIVAX_PIPELINE_LOG_BULK_DIR=./.runtime/development/bulk
AIVAX_PIPELINE_LOG_BULK_BACKUP_DIR=./.runtime/development/bulk-backup

# Analysis log correlation
AIVAX_PIPELINE_ANALYSIS_LOG_MERGE_BACKEND=valkey
AIVAX_PIPELINE_ANALYSIS_LOG_MERGE_KEY_PREFIX=pipeline:development:analysis-log-merge:v1:
AIVAX_PIPELINE_LOG_MERGE_INPUT_SWEEP_INTERVAL_SECONDS=30
AIVAX_PIPELINE_ANALYSIS_LOG_MERGE_TTL_SECONDS=2400
AIVAX_PIPELINE_ANALYSIS_LOG_MERGE_INPUT_FLUSH_AFTER_SECONDS=1800
AIVAX_PIPELINE_ANALYSIS_LOG_MERGE_LATE_OUTPUT_TTL_SECONDS=43200
AIVAX_PIPELINE_MIRROR_TTL_SECONDS=86400
AIVAX_PIPELINE_MIRROR_INPUT_FLUSH_AFTER_SECONDS=82800

# Valkey connection for Management event streams
AIVAX_PIPELINE_VALKEY_HOST=127.0.0.1
AIVAX_PIPELINE_VALKEY_PORT=26379
AIVAX_PIPELINE_VALKEY_DB=0
AIVAX_PIPELINE_VALKEY_PASSWORD=
AIVAX_PIPELINE_VALKEY_SOCKET_CONNECT_TIMEOUT_MS=1000
AIVAX_PIPELINE_VALKEY_SOCKET_TIMEOUT_MS=1000

# Management event streams
AIVAX_PIPELINE_EVENT_FLUSH_INTERVAL_SECONDS=1
AIVAX_PIPELINE_EVENT_DEDUPE_TTL_SECONDS=86400
AIVAX_PIPELINE_EVENT_ATTACHMENT_STREAM_NAME=management:file-asset:v1
AIVAX_PIPELINE_EVENT_ATTACHMENT_INDEX_NAME=aivax_log*
AIVAX_PIPELINE_EVENT_POLICY_NOTIFICATION_STREAM_NAME=management:policy-notification:v1
AIVAX_PIPELINE_EVENT_USER_SYNC_STREAM_NAME=management:user-sync:v1
AIVAX_PIPELINE_POLICY_REGEX_KEY=pipeline:policy:regex:v1
AIVAX_PIPELINE_POLICY_MULTIMODAL_KEY=pipeline:policy:multimodal:v1
AIVAX_PIPELINE_POLICY_SECUXPER_KEY=pipeline:policy:secuxper:v1
AIVAX_PIPELINE_POLICY_SLM_KEY=pipeline:policy:slm:v1

# CSO guard: on/true enables, off/false disables guard and JVM (restart required).
AIVAX_PIPELINE_CSO_ENABLED=false
# CSO guard provider: fasoo(mois) / markany(mogef)
AIVAX_PIPELINE_CSO_PROVIDER=fasoo
AIVAX_PIPELINE_CSO_SKIP_UNSUPPORTED_EXTENSIONS_ENABLED=false
AIVAX_PIPELINE_CSO_SKIP_UNTAGGED_ENABLED=false
AIVAX_PIPELINE_CSO_SKIP_ERROR_ENABLED=false
AIVAX_PIPELINE_CSO_REQUEST_TIMEOUT_SECONDS=5
AIVAX_PIPELINE_CSO_STARTUP_TIMEOUT_SECONDS=15

# User consent
AIVAX_PIPELINE_USER_CONSENT_GLOBAL_BYPASS_ENABLED=true
AIVAX_PIPELINE_USER_CONSENT_REGEX_ENABLED=false
AIVAX_PIPELINE_USER_CONSENT_MULTIMODAL_ENABLED=false
AIVAX_PIPELINE_USER_CONSENT_SLM_ENABLED=false
AIVAX_PIPELINE_USER_CONSENT_SECUXPER_ENABLED=false

# SLM inspection execution limit
AIVAX_PIPELINE_INSPECT_SLM_MAX_INFLIGHT=2
AIVAX_PIPELINE_INSPECT_SLM_QUEUE_SKIP_AFTER=32

# Multimodal inspection execution limits (per worker process)
AIVAX_PIPELINE_INSPECT_MULTIMODAL_FILE_MAX_INFLIGHT=4
AIVAX_PIPELINE_INSPECT_MULTIMODAL_OCR_MAX_INFLIGHT=2
AIVAX_PIPELINE_INSPECT_MULTIMODAL_ACQUIRE_TIMEOUT_SECONDS=300

# SLM inspection (model versions 1-5; enablement: mode.json filters.slm.enabled)
AIVAX_PIPELINE_SLM_URL=http://127.0.0.1:1200/v1/chat/completions
AIVAX_PIPELINE_SLM_REQUEST_TIMEOUT_SECONDS=10
AIVAX_PIPELINE_SLM_MODEL_VERSION=5
AIVAX_PIPELINE_SLM_HTTP_MAX_CONNECTIONS=200
AIVAX_PIPELINE_SLM_HTTP_MAX_KEEPALIVE=50
AIVAX_PIPELINE_SLM_HTTP_CONNECT_TIMEOUT_SECONDS=5

# Multi modal / watermark detection
AIVAX_PIPELINE_FILE_BYPASS_MODE=false
AIVAX_PIPELINE_FILE_READ_TIMEOUT_SECONDS=60
AIVAX_PIPELINE_FILE_ALLOWED_EXTENSIONS=txt,doc,docx,hwp,hwpx,pdf,ppt,pptx,xls,xlsx,bmp,jpeg,jpg,png,gif,webp,avif
AIVAX_PIPELINE_FILE_MAX_SIZE_BYTES=26214400
AIVAX_PIPELINE_UNSUPPORTED_FILE_HANDLING=skip
AIVAX_PIPELINE_OVERSIZED_FILE_HANDLING=skip
AIVAX_PIPELINE_BACKUP_SKIPPED_OVERSIZED_FILES=true
# PDF evidence: pdfplumber (legacy) / pymupdf (reuse text and positions). Restart required.
AIVAX_PIPELINE_PDF_EVIDENCE_ENGINE=pymupdf
AIVAX_PIPELINE_FILE_CONTENT_CHUNK_SIZE=0
AIVAX_PIPELINE_DETAIL_REASON_TEMP_DIR=./.runtime/development/detail-reason
AIVAX_PIPELINE_FILE_BLOCK_BACKUP_DIR=/data/backup/attach_file_backup
AIVAX_PIPELINE_WATERMARK_USE_REGEX_BASE_DRM=true
AIVAX_PIPELINE_WATERMARK_USE_OCR_BASE_WATERMARK=true
AIVAX_PIPELINE_WATERMARK_DRM_DETECT_PATTERN=DRMONE\s+This\s+Document\s+is\s+encrypted\s+and\s+protected\s+by\s+Fasoo\s+DRM
AIVAX_PIPELINE_WATERMARK_DRM_PATTERN_FLAG=18
AIVAX_PIPELINE_WATERMARK_DRM_FILE_HEADER_LIMIT=8096
AIVAX_PIPELINE_WATERMARK_OCR_PATTERNS=["(미\\s*공\\s*개)", "(특\\s*허)", "(외\\s*부)", "(반\\s*출)", "(외부|사외).{0,20}(반출|배포)"]
AIVAX_PIPELINE_WATERMARK_OCR_PATTERN_FLAG=18
AIVAX_PIPELINE_WATERMARK_OCR_MAX_HITCOUNT=2
AIVAX_PIPELINE_WATERMARK_OCR_PAGES=0

# Filter runtime behavior
# Mask replacement text is block_phrases.json "mask_token".
AIVAX_BLOCK_PHRASES_FILE=./tests/fixtures/block_phrases.json
AIVAX_PIPELINE_SSL_PROXY_BYPASS_BITMASK=0

# nNetCDS delivery
AIVAX_PIPELINE_CDS_DELIVERY_ENABLED=false
AIVAX_PIPELINE_CDS_LOG_DIR=.runtime/development/cds-logs
AIVAX_PIPELINE_CDS_DELIVERY_INTERVAL_SECONDS=5
AIVAX_PIPELINE_CDS_DELIVERY_BATCH_SIZE=1000

AIVAX_PIPELINE_CDS_API_URL=http://10.0.50.84:18443/api/ext/v1/traffic-logs
AIVAX_PIPELINE_CDS_API_KEY=nnc_fREHMj0VPkcuXTK5dqBE5kwvTe89v8UgtJ5ClAaBEIQ
AIVAX_PIPELINE_CDS_REQUEST_TIMEOUT_SECONDS=10

AIVAX_PIPELINE_CDS_SRC_PORT=0
AIVAX_PIPELINE_CDS_DST_HOST=example.com
AIVAX_PIPELINE_CDS_DST_PORT=443

# Management internal API
AIVAX_PIPELINE_MANAGEMENT_API_URL=http://127.0.0.1:3012
AIVAX_PIPELINE_MANAGEMENT_REQUEST_TIMEOUT_SECONDS=3

# SecuXperAI
# SecuXper independent filter (enablement: mode.json filters.secuxper.enabled)
AIVAX_PIPELINE_SECUXPERAI_BASE_URL=https://agentpoc-dev.secuxperai.com
AIVAX_PIPELINE_SECUXPERAI_FILTER_PATH=/chat/filter/
AIVAX_PIPELINE_SECUXPERAI_TOKEN_PATH=/auth/token
AIVAX_PIPELINE_SECUXPERAI_REFRESH_PATH=/auth/token/refresh
AIVAX_PIPELINE_SECUXPERAI_TEAM_UUID=88dcd52b-4caa-4657-bbef-3e9284416bd5
AIVAX_PIPELINE_SECUXPERAI_CLIENT_NO=84818e50511674a44fbe161a5613019ef85a666920bab6397f034c79ae519e0d
AIVAX_PIPELINE_SECUXPERAI_SITE_CODE=test-wt
AIVAX_PIPELINE_SECUXPERAI_SYNC_MODE=true
AIVAX_PIPELINE_SECUXPERAI_TOKEN_KEY=aivax:secuxperai:access-token:v1
AIVAX_PIPELINE_SECUXPERAI_TOKEN_LOCK_KEY=aivax:secuxperai:access-token-lock:v1
AIVAX_PIPELINE_SECUXPERAI_TOKEN_LOCK_TTL_SECONDS=10
AIVAX_PIPELINE_SECUXPERAI_TOKEN_WAIT_SECONDS=2
AIVAX_PIPELINE_SECUXPERAI_REQUEST_TIMEOUT_SECONDS=10
AIVAX_PIPELINE_SECUXPERAI_CONNECT_TIMEOUT_SECONDS=5

# Enable migrated aivax-toolkit cleanup and backup schedulers
AIVAX_TOOLKIT_ENABLED=false
