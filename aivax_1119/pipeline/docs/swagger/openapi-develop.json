              }
            },
            "description": "입력 로그 필터의 원본 응답. 기본 응답은 action=allow."
          },
          "secret_filter": {
            "type": "object",
            "additionalProperties": true,
            "description": "action/action_code/masked_contents/block_message. 정규식 block에도 마스킹 문자열 포함."
          },
          "file_block_filter": {
            "type": "object",
            "additionalProperties": true,
            "description": "미탐지 action은 빈 문자열일 수 있음. file_summary, 정책 필드, 조건부 file_info/detail_reason."
          },
          "slm_filter": {
            "type": "object",
            "additionalProperties": true,
            "description": "기본 action/action_code, masking/block 메시지. slm_content는 skip/통신 실패에서 생략 가능."
          }
        },
        "additionalProperties": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "DevelopLogEvidence": {
        "type": "object",
        "additionalProperties": true,
        "description": "입력 로그 버퍼. 최종 저장 완료 증명이 아님. input_filter 제외 시 사용자·원문 등 공통 필드도 보장하지 않음. CSO 및 현재의 오류 정규화 없음.",
        "properties": {
          "filter_detect": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": true,
              "description": "Regex: target/evidence, 파일: targets/file_summary, SLM: slm_content. 실행 시 started_at/completed_at(UTC)/duration_ms. Regex match는 위치를 포함한 문자열이며 start/end 정수 보장 없음."
            },
            "description": "필터별 로그 목록. Regex는 target/evidence, 파일은 targets/file_summary, SLM은 slm_content를 사용한다."
          },
          "mode": {
            "type": "string",
            "description": "로그 대표 판정. final_decision.action과 다를 수 있음."
          },
          "masked_contents": {
            "type": [
              "string",
              "null"
            ],
            "description": "대표 로그의 마스킹 콘텐츠. 해당 키가 없으면 null."
          },
          "policy": {
            "type": "object",
            "additionalProperties": true,
            "description": "대표 로그에서 가져온 정책 정보. 정책이 없으면 하위 식별 문자열은 빈 문자열."
          }
        }
      },
      "DevelopNotFound": {
        "type": "object",
        "required": [
          "detail"
