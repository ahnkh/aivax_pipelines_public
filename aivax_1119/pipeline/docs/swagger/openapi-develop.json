      "DevelopFinalDecision": {
        "type": "object",
        "required": [
          "action",
          "action_code",
          "masked_contents",
          "block_message",
          "message_id"
        ],
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "allow",
              "block",
              "masking"
            ],
            "description": "미탐지·accept 정책 탐지의 최종 응답은 allow. 현재의 accept/failed/빈 action 계약을 적용하지 않음."
          },
          "action_code": {
            "type": "integer",
            "enum": [
              0,
              1,
              2
            ],
            "description": "allow=0, block=1, masking=2."
          },
          "masked_contents": {
            "type": "string",
            "description": "정규식 block도 마스킹한 원문을 포함. SLM masking은 안내문."
          },
          "block_message": {
            "type": "string",
            "description": "선택한 필터의 차단·안내 문구. 없으면 빈 문자열."
          },
          "message_id": {
            "type": "string",
            "description": "요청 ID 또는 INPUT이 생성한 ID. develop은 앞뒤 공백을 제거하지 않는다."
          }
        }
      },
      "DevelopFilterResults": {
