          }
        }
      },
      "DevelopInputResponse": {
        "type": "object",
        "required": [
          "api_code",
          "api_message_code",
          "api_command",
          "completed_date",
          "final_decision"
        ],
        "properties": {
          "api_code": {
            "type": "integer",
            "const": 200,
            "description": "응답 HTTP 상태 코드. 성공 200, 오류 404. HTTP 200은 검사 성공·보안 허용을 보장하지 않는다."
          },
          "api_message_code": {
            "type": "string",
            "const": "success",
