{
  "openapi": "3.1.0",
  "info": {
    "title": "AIVAX Pipeline API — develop (과거 계약)",
    "version": "b05a06be",
    "description": "고정 커밋 `b05a06becb5e6430b603d0d4396e2e3afa4bdf9a`, 확인일 2026-10-18. API_REFERENCE_DEVELOP.md 기준이며 develop 서버 실응답을 채집한 문서는 아님. 현재 API와 구분해 읽는다. 과거 문서의 요청 실행은 비활성화되어 있다. [현재 Swagger](/docs)"
  },
  "tags": [
    {
      "name": "develop INPUT/OUTPUT",
      "description": "고정된 과거 계약"
    }
  ],
  "paths": {
    "/v1/filter/multiple_filter": {
      "post": {
        "tags": [
          "develop INPUT/OUTPUT"
        ],
        "operationId": "developInput",
        "summary": "과거 INPUT: 프롬프트 검사",
        "description": "요청 순서대로 실행. 최초 block, 없으면 최초 masking, 둘 다 없으면 allow/0. 기본 next_detect_after_block=false. SSL 우회는 취합 반복문을 break하므로 뒤 판정이 반영되지 않을 수 있음. SLM 통신 실패는 다른 탐지가 없으면 allow로 이어질 수 있음. CSO·동의 전용 우회·Mirror 즉시 접수 분기는 이 명령에 없음. HTTP 200은 허용·검사 성공을 보장하지 않음.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DevelopInputRequest"
              },
              "example": {
                "message_id": "msg-001",
                "ai_service": 1,
                "prompt": "회의 내용을 요약해 주세요.",
                "filter_list": [
                  "input_filter",
                  "secret_filter",
                  "file_block_filter",
                  "slm_filter"
                ],
                "attachments": [],
                "debug": true
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "과거 구현의 성공 envelope",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DevelopInputResponse"
                },
                "example": {
                  "api_code": 200,
                  "api_message_code": "success",
                  "api_command": "pipeline multiple filter",
                  "final_decision": {
                    "action": "allow",
                    "action_code": 0,
                    "masked_contents": "",
                    "block_message": "",
                    "message_id": "msg-001"
                  },
                  "completed_date": "2026-10-18T12:00:01"
                }
              }
            }
          },
          "404": {
            "description": "미등록 필터 또는 output_filter. block 뒤 내부 출력 호출에서도 발생 가능.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DevelopNotFound"
                }
              }
            }
          },
          "422": {
            "description": "타입 등 DTO 검증 오류. 현재의 동의 ID 검증은 없음.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DevelopValidationError"
                }
              }
            }
          },
          "500": {
            "description": "null 목록·파일 이름·경로, 검사·파싱·후속 처리 예외. 공통 envelope 보장 없음."
          }
        }
      }
    },
    "/v1/filter/output_filter": {
      "post": {
        "tags": [
          "develop INPUT/OUTPUT"
        ],
        "operationId": "developOutput",
        "summary": "과거 OUTPUT: AI 응답 로그",
        "description": "같은 message_id로 INPUT과 병합. debug=true여도 응답 확장 없음. 성공은 최종 OpenSearch 반영 완료를 보장하지 않음.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DevelopOutputRequest"
              },
              "example": {
                "message_id": "msg-001",
                "ai_service": 1,
                "llm_output": "회의 요약입니다."
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "과거 구현의 성공 envelope",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DevelopOutputResponse"
                },
                "example": {
                  "api_code": 200,
                  "api_message_code": "success",
                  "api_command": "output api router",
                  "out_result": {},
                  "completed_date": "2026-10-18T12:00:01"
                }
              }
            }
          },
          "404": {
            "description": "미등록 필터 또는 output_filter. block 뒤 내부 출력 호출에서도 발생 가능.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DevelopNotFound"
                }
              }
            }
          },
          "422": {
            "description": "타입 등 DTO 검증 오류. 현재의 동의 ID 검증은 없음.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DevelopValidationError"
                }
              }
            }
          },
          "500": {
            "description": "null 목록·파일 이름·경로, 검사·파싱·후속 처리 예외. 공통 envelope 보장 없음."
          }
        }
      }
    }
  },
