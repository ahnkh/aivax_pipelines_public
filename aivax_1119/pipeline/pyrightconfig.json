{
  "include": [
    "src"
  ],
  "exclude": [
    "**/__pycache__"
  ],
  "extraPaths": [
    "."
  ],
  "venvPath": ".",
  "venv": ".venv",
  "pythonVersion": "3.13",
  "typeCheckingMode": "standard",
  "reportAbstractUsage": "error",
  "reportMissingImports": "warning",
  "reportMissingTypeStubs": "none"
}
