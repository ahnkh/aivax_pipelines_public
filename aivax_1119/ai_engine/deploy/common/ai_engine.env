# AIVAX ai_engine ops env → /etc/aivax/ai_engine.env
# Owned by ai_engine/deploy/*/install.sh only. Do not overwrite from pipeline.

# --- Paths ---
AIVAX_ENGINE_ROOT=/home1/aivax/ai_engine
AIVAX_POLICY_SOCKET=/run/aivax/policy.sock
# Pipeline URL (ai_engine calls this; Pipeline install owns the server)
AIVAX_PIPELINE_URL=http://127.0.0.1:9099

# --- Inline engine (ChatGate UDS); also in aivax-engine-inline.service.d/cpu.conf ---
AIVAX_CPU_AI_ENGINE=16

# --- Mirror SHM consumer ---
# Default = Inline-lab 1G (8 workers). Sangam KHFC: 16 workers, see
# mirror_engine/docs/sangam-khfc-wipe-reinstall.md (SKIP_ENV=1 then overlay).
AIVAX_SHM_WORKERS=8
AIVAX_SHM_CPU_LIST=18,19,20,21,22,23,36,37
AIVAX_SHM_NAME=aivax_eve_ring
AIVAX_SHM_META=/tmp/aivax_eve_ring.meta.json

# Policy API from SHM workers — product requires 1 (same Pipeline :9099 as Inline).
# 0=local extract only (lab/debug); do not ship or run field with 0.
AIVAX_POLICY_API=1
AIVAX_POLICY_SERVER_URL=http://127.0.0.1:9099
AIVAX_POLICY_API_TIMEOUT_MS=15000
# Inline ChatGate UDS concurrent Pipeline calls (default service: 384).
AIVAX_POLICY_API_MAX_INFLIGHT=384
AIVAX_POLICY_API_POOL_LIMIT=384
# Mirror only: wait this long for Pipeline accept (not SLM). Inline ignores this.
AIVAX_POLICY_API_ACCEPT_TIMEOUT_MS=5000

# --- ChatGPT stream_handoff parent map (cross SHM worker) ---
# Same Valkey as pipeline log-merge. Without this, high-reasoning WS answers
# on a different worker than the HTTP handoff get parent=- and never merge.
AIVAX_RESUME_PARENT_BACKEND=valkey
AIVAX_VALKEY_HOST=127.0.0.1
AIVAX_VALKEY_PORT=6379
# AIVAX_VALKEY_URL=
AIVAX_RESUME_PARENT_TTL_SEC=3600
AIVAX_RESUME_PARENT_PREFIX=aivax:chatgpt_resume_parent:
